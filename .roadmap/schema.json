{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rmp.dev/schemas/roadmap-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "title",
    "items",
    "relationships",
    "evidence",
    "recommendations",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "recommendations": { "type": "array", "items": { "$ref": "#/$defs/recommendation" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$" },
      "additionalProperties": { "type": "object" }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "horizon",
        "commitment",
        "confidence",
        "extensions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(out|del|mil|rel)-[a-z0-9][a-z0-9-]*$" },
        "kind": { "enum": ["outcome", "deliverable", "milestone", "release"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "enum": ["proposed", "active", "blocked", "completed", "cancelled"] },
        "horizon": { "enum": ["now", "next", "later"] },
        "commitment": { "enum": ["exploratory", "planned", "committed"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "signal": { "$ref": "#/$defs/signal" },
        "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } },
        "schedule": { "$ref": "#/$defs/schedule" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "outcome" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "id": { "type": "string", "pattern": "^out-" },
              "signal": true,
              "measurements": true
            },
            "required": ["signal", "measurements"]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "deliverable" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "type": "string", "pattern": "^del-" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "milestone" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "type": "string", "pattern": "^mil-" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "release" } }, "required": ["kind"] },
          "then": {
            "properties": { "id": { "type": "string", "pattern": "^rel-" }, "schedule": true },
            "required": ["schedule"]
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "target", "unit"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "target": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "value", "successful", "evidenceIds"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "value": { "type": "number" },
        "successful": { "type": "boolean" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "evidenceIds"],
      "properties": {
        "precision": { "enum": ["none", "window", "exact"] },
        "earliest": { "type": "string", "format": "date" },
        "latest": { "type": "string", "format": "date" },
        "date": { "type": "string", "format": "date" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-" },
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "enum": ["supports", "delivers", "gates", "dependsOn", "blocks"] },
        "expectedImpact": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "source", "sourceRef", "observedAt", "summary", "extensions"],
      "properties": {
        "id": { "type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$" },
        "class": { "$ref": "#/$defs/evidenceClass" },
        "source": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "itemId",
        "proposedStatus",
        "supportingEvidenceIds",
        "conflictingEvidenceIds",
        "confidence",
        "rationale",
        "requiredApprover",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^rec-[a-z0-9][a-z0-9-]*$" },
        "itemId": { "type": "string" },
        "proposedStatus": { "enum": ["proposed", "active", "blocked", "completed", "cancelled"] },
        "supportingEvidenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-" },
          "uniqueItems": true
        },
        "conflictingEvidenceIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-" },
          "uniqueItems": true
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 1 },
        "requiredApprover": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "accepted", "rejected", "superseded"] }
      }
    },
    "evidenceClass": {
      "enum": ["deterministic", "corroborated", "observedOutcome", "inferred", "strategic"]
    }
  }
}
