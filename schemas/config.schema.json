{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rmp.dev/schemas/config-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "$ref": "#/$defs/disposition"
        },
        "corroborated": {
          "$ref": "#/$defs/disposition"
        },
        "observedOutcome": {
          "$ref": "#/$defs/disposition"
        },
        "inferred": {
          "$ref": "#/$defs/disposition"
        },
        "strategic": {
          "$ref": "#/$defs/disposition"
        }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": ["outcome", "delivery", "release", "dependency", "evidence"]
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notion": {
          "$ref": "#/$defs/notion"
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "disposition": {
      "enum": ["automatic", "recommendation", "approval"]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataSourceId", "titlePropertyId", "statusPropertyId"],
      "properties": {
        "dataSourceId": {
          "type": "string",
          "format": "uuid"
        },
        "titlePropertyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "statusPropertyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "publishDatePropertyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "typePropertyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "blogPropertyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seriesPropertyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "collectionTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
