{
  "name": "roadmap-maintenance-protocol",
  "version": "0.1.0",
  "description": "Offline-first roadmap maintenance protocol toolkit for repositories.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rmp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "roadmap",
    "repository",
    "protocol",
    "cli"
  ],
  "author": "RMP contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.0.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
